# Base URL of the backend API. Leave empty in development to use the Vite proxy (/api -> VITE_DEV_PROXY_TARGET).
VITE_API_URL=
# Socket.IO server origin. Leave empty to use the same origin as the page (works with the Vite proxy).
VITE_SOCKET_URL=
# Google OAuth client id (same value as the backend GOOGLE_CLIENT_ID). Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=
# Used only by `vite dev` to proxy /api and /socket.io
VITE_DEV_PROXY_TARGET=http://localhost:5000
# ICE servers for calls come from the API (GET /api/v1/calls/ice); configure TURN on the backend.

# The AI assistant service (the Python service in chatbot/). Leave it empty and the assistant button
# simply does not appear — better than a button that apologises when pressed.
VITE_ASSISTANT_URL=http://localhost:8000
