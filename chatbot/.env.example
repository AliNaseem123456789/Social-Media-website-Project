# Copy to .env. With the defaults below the service runs with no API keys at all: the "fake" providers
# answer deterministically, which is enough to develop the whole UI and run the tests.

APP_ENV=development
PORT=8000
LOG_LEVEL=info

# The Node API. Every read and write goes through it as the person asking.
API_BASE_URL=http://localhost:5000/api/v1
API_TIMEOUT_SECONDS=12

# Must match the backend exactly, or every request here is a 401.
JWT_ACCESS_SECRET=
JWT_ISSUER=social-api
JWT_AUDIENCE=social-web

# Service-to-service calls from the Node API (embeddings, moderation triage). Must equal the backend's
# ASSISTANT_INTERNAL_SECRET. Leaving it empty closes /internal/* entirely rather than opening it.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=

CORS_ORIGINS=http://localhost:5173

# fake | groq        (chat, and voice transcription)
TEXT_PROVIDER=fake
AUDIO_PROVIDER=fake
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_GUARD_MODEL=openai/gpt-oss-safeguard-20b
GROQ_AUDIO_MODEL=whisper-large-v3-turbo

# fake | gemini      (alt text, and embeddings for search)
VISION_PROVIDER=fake
EMBED_PROVIDER=fake
GOOGLE_API_KEY=
# Must be a real model id — run scripts/doctor.py to see which ones this key can reach.
GEMINI_VISION_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMENSIONS=768

MAX_TOOL_ROUNDS=4
MAX_OUTPUT_TOKENS=700
