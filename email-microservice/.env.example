NODE_ENV=development
SERVICE_NAME=email-service
PORT=5001
LOG_LEVEL=info

# Must match the backend's RABBITMQ_URL and RABBITMQ_PREFIX
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFIX=social
RABBITMQ_PREFETCH=5
RABBITMQ_RETRY_DELAYS_MS=10000,60000,300000

# smtp | log   (log renders emails and prints them instead of sending, handy locally)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Circle
MAIL_FROM_ADDRESS=

APP_NAME=Circle
APP_URL=http://localhost:5173
SUPPORT_EMAIL=
