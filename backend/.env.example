# ---------- Service ----------
NODE_ENV=development
SERVICE_NAME=social-api
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info
# Number of reverse proxies in front of the app (nginx = 1). Needed for correct client IPs and rate limits.
TRUST_PROXY=1
# Comma separated list of modules this process serves, or * for all:
# auth,users,posts,friends,chat,notifications,feed,search,analytics
ENABLED_MODULES=*

# ---------- Frontend ----------
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- Database (Supabase Postgres connection string) ----------
# Use the pooled connection string from Supabase > Project Settings > Database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=social:

# ---------- RabbitMQ ----------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_PREFIX=social
RABBITMQ_PREFETCH=10
RABBITMQ_RETRY_DELAYS_MS=5000,30000,120000

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=social-api
JWT_AUDIENCE=social-web
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=rt
# Production with the frontend on another domain: COOKIE_SECURE=true and COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=false
GOOGLE_CLIENT_ID=

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=5

# ---------- Object storage ----------
# supabase | s3
STORAGE_DRIVER=supabase
STORAGE_BUCKET_POSTS=post-images
STORAGE_BUCKET_AVATARS=avatars
UPLOAD_MAX_BYTES=5242880
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Feed ----------
FEED_SIZE=300
FEED_TTL_SECONDS=3600
# Deprecated GraphQL feed at /api/graphql, off by default
ENABLE_LEGACY_GRAPHQL=false

# ---------- Workers (src/workers/index.js) ----------
WORKERS=notifications,feed,analytics,scheduler
# Run these workers inside the API process instead of a separate worker process.
# Useful on hosts without background workers (e.g. Render free tier): EMBEDDED_WORKERS=*
EMBEDDED_WORKERS=

# ---------- Calls (WebRTC) ----------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# coturn with `static-auth-secret`: the API hands out short lived credentials from GET /api/v1/calls/ice
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=3600

# Maximum images per post
MAX_POST_IMAGES=4
